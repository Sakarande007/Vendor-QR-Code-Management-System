FROM node:20-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Build-time API URL (required for split-domain deploy: https://api.yourdomain.com)
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}

# Optional invoice letterhead / company branding (passed from docker-compose build args)
ARG VITE_COMPANY_NAME
ARG VITE_COMPANY_LEGAL_NAME
ARG VITE_COMPANY_WORKS_ADDRESSES
ARG VITE_COMPANY_REG_OFFICE
ARG VITE_COMPANY_BILLING_LABEL
ARG VITE_COMPANY_ADDRESS
ARG VITE_COMPANY_GST
ARG VITE_COMPANY_PAN
ARG VITE_COMPANY_PHONE
ARG VITE_COMPANY_FAX
ARG VITE_COMPANY_EMAIL
ARG VITE_COMPANY_LOGO_URL

ENV VITE_COMPANY_NAME=${VITE_COMPANY_NAME}
ENV VITE_COMPANY_LEGAL_NAME=${VITE_COMPANY_LEGAL_NAME}
ENV VITE_COMPANY_WORKS_ADDRESSES=${VITE_COMPANY_WORKS_ADDRESSES}
ENV VITE_COMPANY_REG_OFFICE=${VITE_COMPANY_REG_OFFICE}
ENV VITE_COMPANY_BILLING_LABEL=${VITE_COMPANY_BILLING_LABEL}
ENV VITE_COMPANY_ADDRESS=${VITE_COMPANY_ADDRESS}
ENV VITE_COMPANY_GST=${VITE_COMPANY_GST}
ENV VITE_COMPANY_PAN=${VITE_COMPANY_PAN}
ENV VITE_COMPANY_PHONE=${VITE_COMPANY_PHONE}
ENV VITE_COMPANY_FAX=${VITE_COMPANY_FAX}
ENV VITE_COMPANY_EMAIL=${VITE_COMPANY_EMAIL}
ENV VITE_COMPANY_LOGO_URL=${VITE_COMPANY_LOGO_URL}

RUN npm run build

FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
