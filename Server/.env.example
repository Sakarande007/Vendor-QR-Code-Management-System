# =============================================================================
# Vendor QR Invoice Management System — Environment Variables
# Copy to .env and fill in values. Never commit .env to version control.
# =============================================================================

# --- Application ---
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
TRUST_PROXY=1

# Cross-subdomain production auth (split app + api hosts)
# COOKIE_SAME_SITE=none
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.yourdomain.com
# CORS_ORIGINS=https://www.yourdomain.com

REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=30000
CLUSTER_ENABLED=false
CLUSTER_WORKERS=auto
HEALTH_MIN_DISK_FREE_PERCENT=5

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vendor_qr_invoice
# Pool: min warmed on startup, max concurrent connections
DB_POOL_MIN=5
DB_POOL_MAX=50
DB_POOL_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=30000
DB_SLOW_QUERY_MS=500
DB_DEADLOCK_RETRIES=3
DB_POOL_MONITOR=false
# SSL (set DB_SSL=true in production behind managed MySQL)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=/path/to/ca.pem

# --- Redis (sessions, rate limits, QR scan dedup) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=vqr:
REDIS_TLS=false
REDIS_LAZY_CONNECT=false
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_MAX_RETRIES=3
REDIS_SESSION_TTL_SEC=86400
REDIS_REFRESH_DENYLIST_TTL_SEC=604800
REDIS_RATE_LIMIT_WINDOW_SEC=60
REDIS_QR_SCAN_DEDUP_TTL_SEC=300

# --- JWT / Auth ---
JWT_ACCESS_SECRET=change-me-use-long-random-string-min-32-chars
JWT_REFRESH_SECRET=change-me-different-from-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=30

# --- Encryption (AES-256-GCM; 32-byte key as 64-char hex or base64) ---
# Required for invoice submit + QR/PDF. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
QR_ENCRYPTION_KEY=

# --- QR code signing & verify API ---
QR_SECRET_KEY=change-me-min-32-characters-for-hmac-signing
QR_VERIFY_API_KEY=change-me-company-scanner-api-key
QR_VERIFY_IP_MAX_PER_MIN=10
QR_VERIFY_API_KEY_MAX_PER_MIN=100

# --- JWT ---
JWT_ISSUER=vendor-qr-api
JWT_AUDIENCE=vendor-qr-client

# --- Rate limiting ---
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_REFRESH_MAX=20
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_SEC=900
FORGOT_PASSWORD_MAX_PER_HOUR=3
FORGOT_PASSWORD_IP_MAX_PER_HOUR=10
REFRESH_VERIFY_IP=false

# --- SMTP (welcome + OTP emails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# --- Auth / OTP ---
OTP_RESET_TTL_SEC=600
REDIS_ACCESS_DENYLIST_TTL_SEC=900

# --- ERP / PO sync (future integration) ---
ERP_SYNC_ENABLED=false
ERP_API_URL=
ERP_API_KEY=

# --- Master data cache (Redis) ---
MASTER_CACHE_PLANTS_TTL_SEC=3600
MASTER_CACHE_STORAGE_TTL_SEC=3600
MASTER_CACHE_MATERIALS_TTL_SEC=1800

# --- API response cache (Redis cache-aside) ---
CACHE_VENDOR_PO_LIST_TTL_SEC=30
CACHE_PO_DETAIL_TTL_SEC=60
CACHE_QR_IMAGE_TTL_SEC=86400
CACHE_INVOICE_SUBMIT_STATUS_TTL_SEC=3600

# --- Invoice submit queue (Bull + Redis) — off by default for backward compatibility ---
INVOICE_QUEUE_ENABLED=false
INVOICE_QUEUE_CONCURRENCY=3
INVOICE_QUEUE_RATE_MAX=50

# --- Logging ---
LOG_LEVEL=info
