# Caddy — automatic HTTPS for erpdigitalbarcode.in
# Install Caddy on the VPS host, then:
#   sudo cp deploy/caddy/Caddyfile.example /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Set HTTP_PORT=8080 in .env so the Docker gateway binds :8080 (Caddy uses :80/:443).

erpdigitalbarcode.in {
  redir https://www.erpdigitalbarcode.in{uri} permanent
}

www.erpdigitalbarcode.in {
  reverse_proxy 127.0.0.1:8080
}

api.erpdigitalbarcode.in {
  reverse_proxy 127.0.0.1:8080
}
