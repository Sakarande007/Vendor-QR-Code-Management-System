# API container environment — copy to deploy/env/api.env and customize.
# docker-compose.prod.yml loads this file for the api service.

NODE_ENV=production
PORT=5000
TRUST_PROXY=1
CLUSTER_ENABLED=false

# Set in compose .env or here (compose overrides DB_HOST/REDIS_HOST)
CLIENT_URL=https://www.pinwardbarcode.in
API_BASE_URL=https://api.pinwardbarcode.in

DB_HOST=mysql
DB_PORT=3306
DB_USER=vendorqr
DB_NAME=vendor_qr_invoice
DB_POOL_MIN=2
DB_POOL_MAX=30

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_KEY_PREFIX=vqr:

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=2d
BCRYPT_ROUNDS=12

# Cross-subdomain auth (frontend on yourdomain.com, API on api.yourdomain.com)
COOKIE_SAME_SITE=none
COOKIE_SECURE=true
COOKIE_DOMAIN=.pinwardbarcode.in

# Rate limits — enabled in production
DISABLE_RATE_LIMIT=false

LOG_LEVEL=info

# Optional SMTP
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@yourdomain.com
