# =============================================================================
# Production Docker Compose — copy to project root as .env and fill in values
# Usage: docker compose -f docker-compose.prod.yml --env-file .env up -d --build
# =============================================================================

# --- Public domains (DNS A records → VPS) ---
# FRONTEND_DOMAIN: nginx server_name — space-separated if apex + www both point here
FRONTEND_DOMAIN=www.pinwardbarcode.in pinwardbarcode.in
API_DOMAIN=api.pinwardbarcode.in
HTTP_PORT=80

# --- Client build (Vite) — baked into web image at build time ---
VITE_API_URL=https://api.pinwardbarcode.in
VITE_COMPANY_NAME=Paranjape Autocast Pvt. Ltd.
VITE_COMPANY_LEGAL_NAME=Paranjape Autocast(P)Ltd
VITE_COMPANY_ADDRESS=J-15/16, ADDITIONAL M.I.D.C\nSATARA-415004, Maharashtra, India
VITE_COMPANY_GST=27AABCP0318G1ZT
VITE_COMPANY_PAN=AABCP0318G
VITE_COMPANY_PHONE=02162-240351
VITE_COMPANY_FAX=02162-240350
VITE_COMPANY_EMAIL=accounts@example.com
VITE_COMPANY_LOGO_URL=/paranjape-logo.png
# Optional letterhead (use \n for new lines in compose .env)
VITE_COMPANY_WORKS_ADDRESSES=
VITE_COMPANY_REG_OFFICE=
VITE_COMPANY_BILLING_LABEL=

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root-password
DB_PASSWORD=change-me-db-password

# --- Redis ---
REDIS_PASSWORD=change-me-redis-password

# --- API runtime (see deploy/env/api.env.example for full list) ---
CLIENT_URL=https://www.pinwardbarcode.in
API_BASE_URL=https://api.pinwardbarcode.in
JWT_ACCESS_SECRET=change-me-long-random-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-long-random-refresh-secret-min-32-chars
ENCRYPTION_KEY=64-char-hex-from-crypto-randomBytes-32
QR_SECRET_KEY=change-me-min-32-characters-for-hmac-signing
QR_VERIFY_API_KEY=change-me-company-scanner-api-key
COOKIE_SAME_SITE=none
COOKIE_SECURE=true
# Parent domain so refresh cookie works across app + api subdomains
COOKIE_DOMAIN=.pinwardbarcode.in
# Apex domain if users open https://pinwardbarcode.in (without www)
CORS_ORIGINS=https://pinwardbarcode.in

# --- Optional: pull pre-built images from GHCR instead of local build ---
# API_IMAGE=ghcr.io/your-org/your-repo/api:latest
# WEB_IMAGE=ghcr.io/your-org/your-repo/web:latest
